# ---------------------------------------------------------------------------
# My Cashify API — environment configuration
# Copy to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

NODE_ENV=development
# Northflank/Docker inject PORT; the API binds 0.0.0.0:$PORT.
PORT=3000

# Public URL of this API (used to build the Google OAuth callback URL).
API_PUBLIC_URL=http://localhost:3000

# Web app origin; also the default CORS origin and post-login redirect target.
APP_WEB_URL=http://localhost:8081
# Extra allowed origins, comma separated (e.g. a LAN IP used by a physical Android device).
CORS_ORIGINS=

# Secret used to sign session JWTs. Generate with: openssl rand -base64 48
JWT_SECRET=replace-me-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=30d
# Session cookie (web). Use `none` + HTTPS when the web app and API live on different sites.
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
# Deep-link scheme of the Android app (must match "scheme" in apps/mobile/app.json).
AUTH_NATIVE_SCHEME=finance

# --- Google OAuth (identifies the user; openid/email/profile scopes only) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Defaults to ${API_PUBLIC_URL}/auth/google/callback when empty.
GOOGLE_OAUTH_REDIRECT_URI=

# --- Google service account (reads/writes spreadsheets shared with it) ---
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private key from the service-account JSON. Keep the quotes; \n is expanded.
GOOGLE_PRIVATE_KEY=""

# Optional app-owned registry spreadsheet holding the Users sheet.
# When empty, users are stored in a local JSON file under DATA_DIR (development only).
GOOGLE_SPREADSHEET_ID=
# Directory of the JSON user store. The Docker image sets /data (mount a persistent volume there).
DATA_DIR=./data

# Development only: `memory` serves a seeded in-memory demo spreadsheet so the whole app can be
# tried without Google credentials (connect https://docs.google.com/spreadsheets/d/1DemoFinanceSpreadsheetIdForLocalDevelopment00/edit).
SHEETS_BACKEND=google

# --- Rate limiting ---
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
