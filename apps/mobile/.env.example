# Base URL of the My Cashify API (no trailing slash). Production web: the public API origin, e.g. https://api.example.com (or /api when proxied on the same host).
# Web / Android emulator on the same machine: http://localhost:3000 (emulator is remapped to 10.0.2.2 automatically)
# Physical Android device: use your computer's LAN IP, e.g. http://192.168.1.20:3000
# Leave empty in development to derive it from the Expo dev-server host.
EXPO_PUBLIC_API_URL=http://localhost:3000
