{
  "extends": "@finance/config/tsconfig/node.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "types": ["node", "jest"],
    "incremental": true,
    "tsBuildInfoFile": "dist/.tsbuildinfo"
